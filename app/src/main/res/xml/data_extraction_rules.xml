<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="hesabno_native_store.db" />
        <include domain="file" path="hesabno_auto_backup.json" />
        <include domain="file" path="hesabno_auto_backup.bak.json" />
        <include domain="file" path="hesabno_attachments" />
